# Copy to .env and fill in. .env is git-ignored; never commit real secrets.
# Generate random secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---------- Core ----------
# Shared key used by the UI proxy, the voice agent and n8n to call the CRM API (min 16 chars)
CRM_API_KEY=change-me-to-a-long-random-string
CRM_API_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
# "Today"/"tomorrow" are resolved in this timezone
APP_TIMEZONE=America/New_York

# ---------- LiveKit Cloud (https://cloud.livekit.io -> Settings -> Keys) ----------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=crm-voice-agent

# ---------- AI providers ----------
DEEPGRAM_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
DEEPGRAM_TTS_VOICE=aura-2-thalia-en

# ---------- Automation ----------
# n8n runs locally via npx (port 5678). Production webhook URL of the "CRM Event Webhook" node.
# n8n reaches this backend at http://localhost:8000.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/crm-events
# Sent as the X-Webhook-Secret header; configure the same value in n8n Header Auth.
N8N_WEBHOOK_SECRET=
# Slack Incoming Webhook. Used directly if n8n is not configured or not reachable.
SLACK_WEBHOOK_URL=
# HMAC secret for inbound leads: POST /api/webhooks/leads
INBOUND_WEBHOOK_SECRET=
